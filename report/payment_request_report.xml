<odoo>
    <!-- A4 Report Action -->
    <record id="action_payment_request_report" model="ir.actions.report">
        <field name="name">Payment Request</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_payment_request.report_payment_request_document</field>
        <field name="report_file">account_payment_request.report_payment_request_document</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- A5 Landscape Report Action -->
    <record id="action_payment_request_report_a5" model="ir.actions.report">
        <field name="name">Payment Request (A5)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_payment_request.payment_request_a5</field>
        <field name="report_file">account_payment_request.payment_request_a5</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>