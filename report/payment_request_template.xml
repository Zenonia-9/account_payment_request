<odoo>
    <template id="report_payment_request_document">
        <t t-call="web.html_container">
            <t t-set="is_grouped" t-value="data.get('group_request', False)"/>
            
            <t t-set="bundles" t-value="[docs] if is_grouped else docs"/>

            <t t-foreach="bundles" t-as="bundle">
                <t t-set="o" t-value="bundle[0] if is_grouped else bundle"/>
                <t t-set="lines" t-value="bundle if is_grouped else bundle"/>
                <t t-set="vr_no" t-value="'BATCH-REQUEST' if is_grouped else o.name"/>

                <t t-call="account_payment_request.payment_request_layout_a4">
                    <style>
                        .page {
                            font-size: 14px;
                        }

                        .payment-request-info .fw-bold {
                            white-space: nowrap;
                        }

                        .payment-request-info .col-7 {
                            overflow-wrap: anywhere;
                        }

                        .compact-table {
                            table-layout: fixed;
                            width: 100%;
                        }

                        .compact-table td,
                        .compact-table th {
                            line-height: 1.5 !important;
                            vertical-align: middle;
                            padding: 4px 5px !important;
                            overflow-wrap: anywhere;
                        }

                        .compact-table .amount-cell {
                            white-space: nowrap;
                        }

                        .compact-table tr {
                            height: auto !important;
                        }
                    </style>
                    <div class="page">
                        <div class="text-center mb-4">
                            <h3 style="text-transform: uppercase; font-weight: bold;">Payment Request Form</h3>
                        </div>

                        <div class="row mb-2 payment-request-info">
                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Supplier No</div>
                                    <div class="col-7">: <span t-field="o.partner_id.business_partner_code"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Supplier Name</div>
                                    <div class="col-7">: <span t-field="o.partner_id.name"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Vr No.</div>
                                    <div class="col-7">: <span t-esc="vr_no"/></div>
                                </div>
                                <div class="row mb-1" t-if="data.get('payment_date')">
                                    <div class="col-5 fw-bold">Vr Date</div>
                                    <div class="col-7">: <span t-esc="data.get('payment_date_display')"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Currency</div>
                                    <div class="col-7">: <span t-field="o.currency_id.name"/></div>
                                </div>
                            </div>
                        </div>

                        <table class="table table-borderless compact-table" style="page-break-inside: avoid;">
                            <t t-set="show_pc_cc" t-value="any(bill.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note') and l.analytic_distribution) for bill in lines)"/>

                            <thead>
                                <tr>
                                    <th style="width: 10mm;">No</th>
                                    <th style="width: 25mm;">Invoice Date</th>
                                    <th>Invoice Number</th>
                                    <th>Reference</th>
                                    <th t-if="show_pc_cc" style="width: 25mm;">PC/CC</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_no" t-value="0"/>
                                <t t-foreach="lines" t-as="bill">
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                    <tr>
                                        <td><span t-esc="line_no"/></td>
                                        <td><span t-esc="bill.invoice_date and bill.invoice_date.strftime('%d-%b-%Y') or ''"/></td>
                                        <td><span t-field="bill.name"/></td>
                                        <td>
                                            <span t-if="bill.vendor_ref" t-field="bill.vendor_ref"/>
                                            <span t-elif="bill.ref" t-field="bill.ref"/>
                                        </td>
                                        <td t-if="show_pc_cc">
                                            <t t-set="analytic_names" t-value="[]"/>
                                            <t t-foreach="bill.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note') and l.analytic_distribution)" t-as="line">
                                                <t t-foreach="line.analytic_distribution.keys()" t-as="analytic_key">
                                                    <t t-foreach="str(analytic_key).split(',')" t-as="analytic_id">
                                                        <t t-if="analytic_id">
                                                            <t t-set="analytic_account" t-value="bill.env['account.analytic.account'].browse(int(analytic_id))"/>
                                                            <t t-if="analytic_account.exists() and analytic_account.name not in analytic_names">
                                                                <t t-set="analytic_names" t-value="analytic_names + [analytic_account.name]"/>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <span t-esc="', '.join(analytic_names)"/>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <span t-esc="bill.amount_total * (-1 if bill.move_type in ('out_refund','in_refund') else 1)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: bill.currency_id}"/>
                                            <!--<span t-field="bill.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: bill.currency_id}"/>-->
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td t-att-colspan="5 if show_pc_cc else 4" class="text-end"><strong>Total Amount</strong></td>
                                    <td class="text-end amount-cell">
                                        <strong>
                                            <!--<t t-set="total_sum" t-value="sum(lines.mapped('amount_total'))"/>-->
                                            <t t-set="total_sum" t-value="sum(     (l.amount_total * (-1 if l.move_type in ('out_refund','in_refund') else 1))     for l in lines )"/>
                                            <span t-out="total_sum" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-5">
                            <div class="row text-center">
                                <div class="col-3"><strong>Approved By</strong></div>
                                <div class="col-3"><strong>Confirmed By</strong></div>
                                <div class="col-3"><strong>Checked By</strong></div>
                                <div class="col-3"><strong>Requested By</strong></div>
                            </div>
                            <div class="row mt-4 text-center">
                                <t t-foreach="range(4)" t-as="x">
                                    <div class="col-3 px-3">
                                        <div style="border-bottom: 1px dotted black; height: 26px;"/>
                                        <div class="small mt-1 text-muted">Sign</div>
                                        <div style="border-bottom: 1px dotted black; height: 26px; margin-top: 22px;"/>
                                        <div class="small mt-1 text-muted">Name</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

