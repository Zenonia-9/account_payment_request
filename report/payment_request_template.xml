<odoo>
    <template id="report_payment_request_document">
        <t t-call="web.html_container">
            <t t-set="is_grouped" t-value="data.get('group_request', False)"/>
            
            <t t-set="bundles" t-value="[docs] if is_grouped else docs"/>

            <t t-foreach="bundles" t-as="bundle">
                <t t-set="o" t-value="bundle[0] if is_grouped else bundle"/>
                <t t-set="lines" t-value="bundle if is_grouped else bundle"/>
                <t t-set="vr_no" t-value="'BATCH-REQUEST' if is_grouped else o.name"/>

                <t t-call="web.external_layout">
                    <style>
                        @page {
                            size: A4 portrait;
                        }

                        .page {
                            font-size: 14px;
                        }

                        .compact-table td,
                        .compact-table th {
                            line-height: 1.5 !important;
                            vertical-align: middle;
                            padding: 4px 5px !important;
                        }

                        .compact-table tr {
                            height: auto !important;
                        }
                    </style>
                    <div class="page">
                        <div class="text-center mb-4">
                            <h3 style="text-transform: uppercase; font-weight: bold;">Payment Request Form</h3>
                        </div>

                        <div class="row mb-2">
                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Supplier No</div>
                                    <div class="col-7">: <span t-field="o.partner_id.business_partner_code"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Supplier Name</div>
                                    <div class="col-7">: <span t-field="o.partner_id.name"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Vr No.</div>
                                    <div class="col-7">: <span t-esc="vr_no"/></div>
                                </div>
                                <div class="row mb-1" t-if="data.get('payment_date')">
                                    <div class="col-5 fw-bold">Request Date</div>
                                    <div class="col-7">: <span t-esc="data.get('payment_date')" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Currency</div>
                                    <div class="col-7">: <span t-field="o.currency_id.name"/></div>
                                </div>
                            </div>
                        </div>

                        <table class="table table-borderless compact-table" style="page-break-inside: avoid;">
                            <t t-set="otherCurrency" t-value="any(bill.currency_id != bill.company_id.currency_id for bill in lines)"/>
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Invoice Date</th>
                                    <th>Invoice Number</th>
                                    <th>Reference</th>
                                    <th t-if="otherCurrency" class="text-end">Amount In Currency</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines" t-as="bill">
                                    <tr>
                                        <td><span t-esc="bill_index + 1"/></td>
                                        <td><span t-field="bill.invoice_date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/></td>
                                        <td><span t-field="bill.name"/></td>
                                        <td><span t-field="bill.vendor_ref"/></td>
                                        <td t-if="otherCurrency" class="text-end">
                                            <span t-if="bill.currency_id != bill.company_id.currency_id" t-field="bill.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: bill.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="bill.amount_total * (-1 if bill.move_type in ('out_refund','in_refund') else 1)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: bill.currency_id}"/>
                                            <!--<span t-field="bill.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: bill.currency_id}"/>-->
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td/>
                                    <td colspan="3"><strong>Total Amount</strong></td>
                                    <td t-if="otherCurrency"/>
                                    <td class="text-end">
                                        <strong>
                                            <!--<t t-set="total_sum" t-value="sum(lines.mapped('amount_total'))"/>-->
                                            <t t-set="total_sum" t-value="sum(     (l.amount_total * (-1 if l.move_type in ('out_refund','in_refund') else 1))     for l in lines )"/>
                                            <span t-out="total_sum" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-5">
                            <div class="row text-center">
                                <div class="col-3"><strong>Approved By</strong></div>
                                <div class="col-3"><strong>Confirmed By</strong></div>
                                <div class="col-3"><strong>Checked By</strong></div>
                                <div class="col-3"><strong>Requested By</strong></div>
                            </div>
                            <div class="row mt-4 text-center">
                                <t t-foreach="range(4)" t-as="x">
                                    <div class="col-3 px-3">
                                        <div style="border-bottom: 1px dotted black; height: 20px;"/>
                                        <div class="small mt-1 text-muted">Sign</div>
                                        <div style="border-bottom: 1px dotted black; height: 20px; margin-top: 20px;"/>
                                        <div class="small mt-1 text-muted">Name</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

