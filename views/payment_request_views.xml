<odoo>
    <record id="view_move_form_inherit_payment_request" model="ir.ui.view">
        <field name="name">account.move.form.inherit.payment.request</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Insert after Register Payment button -->
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_open_payment_request"
                    type="object"
                    string="Request"
                    class="oe_highlight"
                    data-hotkey="r"
                    invisible="state != 'posted' or move_type != 'in_invoice'"
                    groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_payment_request" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.payment.request</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_force_register_payment']" position="after">
                <button name="action_open_payment_request"
                    type="object"
                    string="Request"
                    groups="account.group_account_invoice"
                    invisible="context.get('default_move_type') not in ('in_invoice')"/>
            </xpath>
        </field>
    </record>
</odoo>